# === Claude API (서버측 보관 — 브라우저에 절대 노출 금지) ===
ANTHROPIC_API_KEY=sk-ant-...
PIMM_MODEL=claude-opus-4-8

# === 저장소 ===
# local  = STORAGE_ROOT 폴더에 실파일로 저장 (드라이브 동기 폴더를 가리키면 그대로 Drive에 반영)
# gdrive = Google Drive API 직접 호출 (서비스계정 필요)
STORAGE_BACKEND=local
STORAGE_ROOT=./storage

# gdrive 백엔드용 (STORAGE_BACKEND=gdrive 일 때만)
GDRIVE_SERVICE_ACCOUNT=./service-account.json
# PIMMotion 산출물을 담을 드라이브 폴더 ID (예: [4.핌코프].PIMM-cowork 하위)
GDRIVE_ROOT_FOLDER_ID=

# === 게임크리에이터 연동 ===
# Google Drive 데스크톱 앱의 로컬 동기 폴더 경로.
# 옐로필드/아웃풋섹터/PIMMplayer_JSON 를 가리키면, 툴의 "핸드오프 저장"이
# 이 폴더에 쓰고 Drive 앱이 자동 업로드한다 (별도 Drive API 불필요).
# 예(mac): /Users/gamza/Library/CloudStorage/GoogleDrive-.../PIMMplayer_JSON
PIMM_DRIVE_EXPORT_DIR=

# === 서버 ===
PIMM_HOST=127.0.0.1
PIMM_PORT=8787
